# ==============================================================================
# Nexus Ranaji School Exam System - Environment Configuration Template
# Copy this file to .env and provide your specific deployment credentials.
# ==============================================================================

PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Supabase Backend PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Use the Supabase IPv4 connection pooler URL (Transaction or Session pooler, port 6543)
# Format: postgresql://postgres.[project-ref]:[db-password]@[pooler-host]:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# Supabase Frontend Client Credentials
# ------------------------------------------------------------------------------
# Obtained from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters

# ------------------------------------------------------------------------------
# Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Primary API key for automated exam question generation and AI features
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Comma-separated pool of Gemini API keys for automatic failover/rotation
# GEMINI_API_KEY_POOL=key1,key2,key3
